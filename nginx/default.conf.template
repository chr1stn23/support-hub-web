# Se genera al arrancar el contenedor: ${BACKEND_URL} y ${DNS_RESOLVER} se sustituyen;
# las variables de nginx ($uri, $host…) no.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # El estado del servidor, para el healthcheck del contenedor
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Archivos ocultos (.env, .git…): nunca
    location ~ /\. {
        return 404;
    }

    # La API: mismo origen que la aplicación. "^~" evita que las reglas de archivos estáticos la alcancen.
    location ^~ /api/ {
        # Se vuelve a resolver el backend cada pocos segundos: si se reinicia y cambia de IP, la aplicación se recupera sola
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $backend ${BACKEND_URL};

        # El backend admite 6 MB por petición. nginx, por defecto, corta a 1 MB con una página HTML
        client_max_body_size 7m;

        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Se SOBRESCRIBE (no se añade): aquí nginx es el borde y no debe fiarse de lo que mande el cliente.
        # Detrás de otro proxy o balanceador, configúralo con set_real_ip_from y real_ip_header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Archivos con huella en el nombre (outputHashing: all): su nombre cambia cuando cambia su contenido
    location ~* \.(?:js|mjs|css|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # El resto de archivos estáticos no llevan huella (favicon, imágenes): caché corta
    location ~* \.(?:ico|png|svg|jpe?g|gif|webp|avif|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Las rutas de la aplicación (/tickets, /usuarios/…) son del navegador: se entrega la aplicación
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}

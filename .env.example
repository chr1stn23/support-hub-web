# Copiar este archivo a .env y completar valores
# La carpeta del backend, relativa a este archivo
BACKEND_DIR=../supporthub-api
POSTGRES_PASSWORD=
# Mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
# El primer administrador (solo se crea si todavía no existe ninguno activo)
BOOTSTRAP_ADMIN_EMAIL=admin@tu-empresa.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# Dirección pública de la aplicación y puerto donde se publica
PUBLIC_ORIGIN=http://localhost:8081
HTTP_PORT=8081
# true en producción (HTTPS). false SOLO para probar por http://IP o dominio sin HTTPS;
# en http://localhost, Chrome y Firefox aceptan cookies Secure.
COOKIE_SECURE=true
